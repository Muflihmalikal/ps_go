# =====================================================================
# .env.example — salin menjadi .env lalu isi nilainya. JANGAN commit .env.
# Simpan sebagai UTF-8 (bukan UTF-16 hasil redirect ">" di PowerShell).
# =====================================================================

# --- Aplikasi ---
# local      : error PHP tampil di layar (untuk development)
# production : error disembunyikan dari pengunjung, hanya ditulis ke log
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta

# Kunci rahasia untuk token ID terenkripsi dan pembatasan percobaan.
# WAJIB diganti, minimal 32 karakter, acak. Buat dengan:
#   php -r "echo bin2hex(random_bytes(32));"
# (Nilai contoh di bawah sengaja kurang dari 32 karakter, supaya aplikasi
#  berhenti dengan pesan konfigurasi bila lupa diganti.)
APP_KEY=isi_dengan_64_karakter_acak

# Aktifkan HANYA bila situs berada di balik proxy tepercaya (Nginx, Cloudflare, dsb.)
# yang mengatur header X-Forwarded-Proto. Di lokal biarkan nonaktif.
# APP_TRUST_PROXY=1

# Content-Security-Policy default hanya MELAPORKAN pelanggaran (Console browser).
# Setelah semua halaman bebas peringatan, aktifkan pemblokiran:
# APP_CSP=enforce

# --- Database PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ps_go
DB_USER=isi_user_postgres_anda
DB_PASS=isi_password_postgres_anda

# prefer (lokal) | require (server di luar komputer ini) | verify-full (paling ketat)
DB_SSLMODE=prefer

# --- Unggahan bukti bayar (opsional) ---
# Bawaan: folder storage/uploads di dalam proyek. Di server sungguhan, arahkan ke
# folder DI LUAR web root agar file tidak bisa dibuka lewat URL:
# UPLOAD_DIR=/var/www/ps_go_uploads